{
	"schemaVersion": 1,
	"id": "auto-gg",
	"version": "${version}",
	"name": "auto-gg",
	"description": "This mod send automaticly \",glhf\", at the start of the game (this function is only for supported server) and an \"gg\" (messages can be modified) at the end of the game.",
	"authors": [
		"AlexV8"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/auto-gg/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.auto.gg.Autogg"
		],
		"fabric-datagen": [
			"net.auto.gg.AutoggDataGenerator"
		],
		"modmenu": [
			"net.auto.gg.ModMenuIntegration"
		]
	},
	"mixins": [
		"auto-gg.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}